class Solution {
    public String mergeAlternately(String word1, String word2) {
        int n1 = word1.length();
        int n2 = word2.length();
        int maxlength = Math.max(n1,n2);
        StringBuilder cw = new StringBuilder();
        for(int i = 0; i< maxlength;i++){
            if(i < n1){
                cw.append(word1.charAt(i));
            }
            if(i < n2){
                cw.append(word2.charAt(i));
            }
        }

        return cw.toString();
    }
}
